<local:MyCard Margin="0,4">
    <Border  Margin="10"
             CornerRadius="4">
        <Border.Background>
            <ImageBrush
                ImageSource="{img}"
                Stretch="UniformToFill"/>
        </Border.Background>
        <Border.Effect>
            <BlurEffect Radius="10"
                        RenderingBias="Performance"/>
        </Border.Effect>
    </Border>
    <Border
        CornerRadius="4"
        Background="#000000"
        Opacity="0.5"
        Margin="10">
        <Border.Effect>
            <BlurEffect Radius="10"
                        RenderingBias="Performance"/>
        </Border.Effect>
    </Border>
    <Grid
        Margin="10"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <local:MyImage
            Height="140"
            Source="{img}"/>
        <Border
            CornerRadius="4"
            Background="#000000"
            Opacity="0.3">
        </Border>
    </Grid>
    <Grid Margin="10">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left">
                <StackPanel
                    Grid.Column="1" Margin="0,25,0,0">
                    <TextBlock
                        Margin="2,0,0,0"
                        FontSize="25"
                        FontFamily="Microsoft JhengHei UI"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource ColorBrush8}"
                        ToolTip="{name}"
                        Text="{name}"/>
                    <TextBlock
                        Margin="3,-6,0,0"
                        FontSize="15"
                        FontFamily="Noto Sans SC Medium"
                        Opacity="0.9"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource ColorBrush8}"
                        ToolTip="{name_cn} | {p} feat. {v}"
                        Text="{name_cn} | {p} feat. {v}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                        Orientation="Horizontal"
                Grid.Column="1">
                {rank}
                <Border Background="{DynamicResource ColorBrush4}"
                        CornerRadius="0,25,25,0"
                        Height="50">
                    <StackPanel Margin="5,3,15,3"
                                Orientation="Horizontal">
                        <StackPanel  Margin="3,0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="{DynamicResource ColorBrush8}"
                                Text="{s1}"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource ColorBrush6}"
                                Text="{s1t}"/>
                        </StackPanel>
                        <StackPanel  Margin="3,0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="{DynamicResource ColorBrush8}"
                                Text="{s2}"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource ColorBrush6}"
                                Text="{s2t}"/>
                        </StackPanel>
                        <StackPanel  Margin="3,0">
                            <Border Background="{DynamicResource ColorBrush5}"
                                    CornerRadius="15"
                                    Height="30">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ColorBrush8}"
                                    Text="{s3}"/>
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource ColorBrush6}"
                                Text="{s3t}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="0,5,10,0">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource ColorBrush4}"
                        CornerRadius="10"
                        Height="24">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        Margin="6,0"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ColorBrush8}"
                        Text="Rate: {rate}"
                        ToolTip="本曲目分数与上一期分数的增长率"/>
                </Border>
                <Border Background="{DynamicResource ColorBrush4}"
                        CornerRadius="10"
                        Height="24">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        Margin="6,0"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ColorBrush8}"
                        Text="More: {more}"
                        ToolTip="本曲目分数与下一名分数的增长率"/>
                </Border>
                <StackPanel Orientation="Horizontal"
                            ToolTip="播放 {score_view}&#xa;点赞 {score_like}&#xa;投币 {score_coin}&#xa;收藏 {score_fav}">
                    <TextBlock
                        FontSize="25"
                        FontFamily="Verdana Bold Italic"
                        Foreground="{DynamicResource ColorBrush8}"
                        Text="{score_main}"/>
                    <TextBlock
                        FontSize="25"
                        FontFamily="Verdana Bold Italic"
                        Foreground="{DynamicResource ColorBrush8}"
                        Opacity="0.7"
                        Text="{score_trivial}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:MyCard>
    